---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import TrainingReminder from "@/components/TrainingReminder.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
  showAccent?: boolean;
}

const { title, showAccent = true } = Astro.props;
const documentTitle = title ? `${title} · Team Manager` : "Team Manager";
const { user } = Astro.locals;
const pathname = Astro.url.pathname;
const onApp =
  pathname.startsWith("/dashboard") ||
  pathname.startsWith("/team/") ||
  pathname.startsWith("/calendar") ||
  pathname.startsWith("/ranking");
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{documentTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <header class="border-b bg-card">
      <div class="flex items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="font-semibold text-primary">
          Team Manager
        </a>
        {user ? (
          <nav class="flex items-center gap-4" aria-label="Konto">
            <a
              href="/dashboard"
              class:list={["text-sm font-medium text-primary hover:underline", onApp && "underline"]}
              aria-current={onApp ? "page" : undefined}
            >
              Dashboard
            </a>
            <span class="hidden max-w-48 truncate text-sm text-muted-foreground sm:inline">{user.email}</span>
            <form method="POST" action="/api/auth/signout">
              <button type="submit" class="text-sm font-medium text-primary hover:underline">
                Wyloguj
              </button>
            </form>
          </nav>
        ) : (
          <nav class="flex items-center gap-4" aria-label="Konto">
            <a href="/auth/signin" class="text-sm font-medium text-primary hover:underline">
              Zaloguj się
            </a>
            <a href="/auth/signup" class="text-sm font-medium text-primary hover:underline">
              Załóż konto
            </a>
          </nav>
        )}
      </div>
    </header>
    {showAccent && <div class="h-1.5 bg-accent" aria-hidden="true"></div>}
    <div class="flex flex-1 flex-col">
      <slot />
    </div>
    {user && <TrainingReminder />}
  </body>
</html>
