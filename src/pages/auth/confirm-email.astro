---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      heading: "Konto utworzone",
      description: "Konto jest gotowe. Możesz się zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      heading: "Sprawdź e-mail",
      description: "Wysłaliśmy link aktywacyjny. Kliknij go, aby włączyć konto.",
      linkText: "Wróć do logowania",
    };
---

<Layout title={content.heading}>
  <main class="flex flex-1 items-center justify-center px-4 py-10">
    <div class="w-full max-w-sm rounded-xl border bg-card p-8 text-center shadow-sm">
      <h1 class="mb-3 text-2xl font-semibold">{content.heading}</h1>
      <p class="mb-6 text-muted-foreground">{content.description}</p>
      <a href="/auth/signin" class="text-sm font-medium text-primary hover:underline">
        {content.linkText}
      </a>
    </div>
  </main>
</Layout>
