---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Zaloguj się">
  <main class="flex flex-1 items-center justify-center px-4 py-10">
    <div class="w-full max-w-sm rounded-xl border bg-card p-8 shadow-sm">
      <h1 class="mb-6 text-center text-2xl font-semibold">Zaloguj się</h1>
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-muted-foreground">
        Nie masz konta?{" "}
        <a href="/auth/signup" class="font-medium text-primary hover:underline">
          Załóż konto
        </a>
      </p>
    </div>
  </main>
</Layout>
