---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Załóż konto">
  <main class="flex flex-1 items-center justify-center px-4 py-10">
    <div class="w-full max-w-sm rounded-xl border bg-card p-8 shadow-sm">
      <h1 class="mb-6 text-center text-2xl font-semibold">Załóż konto</h1>
      <SignUpForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-muted-foreground">
        Masz już konto?{" "}
        <a href="/auth/signin" class="font-medium text-primary hover:underline">
          Zaloguj się
        </a>
      </p>
    </div>
  </main>
</Layout>
