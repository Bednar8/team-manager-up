---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;

const points = [
  {
    title: "Trening na wybrany dzień",
    body: "Trener ustawia datę i krótki opis treningu.",
    icon: "calendar",
  },
  {
    title: "Zdjęcie z aplikacji biegowej",
    body: "Zawodnik wgrywa zrzut ze swojej aplikacji.",
    icon: "image",
  },
  {
    title: "Kto oddał i ranking",
    body: "Widać, kto przesłał trening, oraz ranking po kilometrach.",
    icon: "ranking",
  },
];
---

<Layout>
  <main class="mx-auto flex w-full max-w-5xl flex-1 flex-col px-4 py-16">
    <h1 class="text-4xl font-bold text-primary sm:text-5xl">Team Manager</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted-foreground">Aplikacja do zarządzania treningami biegowymi.</p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-3">
      {points.map((point) => (
        <li class="rounded-xl bg-accent p-5">
          <span
            class="mb-4 inline-flex size-10 items-center justify-center rounded-lg bg-card text-primary"
            aria-hidden="true"
          >
            {point.icon === "calendar" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-5"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <path d="M16 2v4M8 2v4M3 10h18" />
              </svg>
            )}
            {point.icon === "image" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-5"
              >
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <circle cx="9" cy="9" r="2" />
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
              </svg>
            )}
            {point.icon === "ranking" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-5"
              >
                <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z" />
                <path d="M7 6H4a3 3 0 0 0 3 3M17 6h3a3 3 0 0 1-3 3" />
              </svg>
            )}
          </span>
          <h2 class="font-semibold">{point.title}</h2>
          <p class="mt-2 text-sm text-muted-foreground">{point.body}</p>
        </li>
      ))}
    </ul>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      {user ? (
        <a
          href="/dashboard"
          class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground hover:bg-primary/90"
        >
          Przejdź do zespołu
        </a>
      ) : (
        <>
          <a
            href="/auth/signin"
            class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground hover:bg-primary/90"
          >
            Zaloguj się
          </a>
          <a
            href="/auth/signup"
            class="inline-flex h-10 items-center justify-center rounded-md border bg-card px-6 text-sm font-medium hover:bg-accent"
          >
            Załóż konto
          </a>
        </>
      )}
    </div>
  </main>
</Layout>
