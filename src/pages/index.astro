---
import Layout from "@/layouts/Layout.astro";
import RouteScene from "@/components/home/RouteScene";
import "../components/home/home.css";

const { user } = Astro.locals;

const points = [
  {
    km: "0 km",
    side: "left",
    title: "Trening na wybrany dzień",
    body: "Trener ustawia datę i krótki opis treningu.",
    icon: "calendar",
  },
  {
    km: "5 km",
    side: "right",
    title: "Zdjęcie z aplikacji biegowej",
    body: "Zawodnik wgrywa zrzut ze swojej aplikacji.",
    icon: "image",
  },
  {
    km: "Meta",
    side: "left",
    title: "Kto oddał i ranking",
    body: "Widać, kto przesłał trening, oraz ranking po kilometrach.",
    icon: "ranking",
    finish: true,
    podium: true,
  },
];
---

<Layout showAccent={false}>
  <main class="home">
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("home-motion");
      }
    </script>
    <section class="home-hero" data-home-hero aria-labelledby="home-title">
      <RouteScene client:load />
      <div class="home-hero__copy">
        <p class="home-kicker">Treningi biegowe zespołu</p>
        <h1 id="home-title">Team Manager</h1>
        <p class="home-hero__lead">Aplikacja do zarządzania treningami biegowymi.</p>
        <div class="home-actions">
          {user ? (
            <a class="home-btn home-btn--solid" href="/dashboard">
              Przejdź do zespołu
            </a>
          ) : (
            <>
              <a class="home-btn home-btn--solid" href="/auth/signin">
                Zaloguj się
              </a>
              <a class="home-btn home-btn--ghost" href="/auth/signup">
                Załóż konto
              </a>
            </>
          )}
        </div>
      </div>
    </section>
    <section class="home-route" aria-labelledby="home-route-title">
      <header class="home-route__head">
        <p>Trasa zespołu</p>
        <h2 id="home-route-title">Od planu do rankingu</h2>
      </header>
      <div class="home-route__body" id="home-route">
        <svg id="home-route-rail" class="home-route__rail" viewBox="0 0 80 800" aria-hidden="true">
          <defs>
            <mask id="home-route-mask" maskUnits="userSpaceOnUse">
              <path
                id="home-route-reveal"
                pathLength="1"
                d="M40 0 C 58 180, 22 340, 40 420 C 58 520, 22 660, 40 800"
                fill="none"
                stroke="white"
                stroke-width="36"
                stroke-linecap="round"
              ></path>
            </mask>
          </defs>
          <path
            id="home-route-dashed"
            d="M40 0 C 58 180, 22 340, 40 420 C 58 520, 22 660, 40 800"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-dasharray="7 11"
            mask="url(#home-route-mask)"
          ></path>
        </svg>
        <ol class="home-waypoints">
          {points.map((point) => (
            <li class="home-waypoint" data-side={point.side}>
              <span class="home-waypoint__km" data-mark={point.finish ? "finish" : undefined}>
                {point.km}
              </span>
              <div class="home-waypoint__motion">
                <article class="home-waypoint__card">
                  <span class="home-waypoint__icon" aria-hidden="true">
                    {point.icon === "calendar" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <path d="M16 2v4M8 2v4M3 10h18" />
                      </svg>
                    )}
                    {point.icon === "image" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <circle cx="9" cy="9" r="2" />
                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                      </svg>
                    )}
                    {point.icon === "ranking" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z" />
                        <path d="M7 6H4a3 3 0 0 0 3 3M17 6h3a3 3 0 0 1-3 3" />
                      </svg>
                    )}
                  </span>
                  <h3>{point.title}</h3>
                  <p>{point.body}</p>
                  {point.podium && (
                    <div class="home-podium" aria-hidden="true">
                      <div class="home-podium__col">
                        <div class="home-podium__bar" style="--h: 64%"></div>
                        <span>2</span>
                      </div>
                      <div class="home-podium__col home-podium__col--gold">
                        <div class="home-podium__bar" style="--h: 100%"></div>
                        <span>1</span>
                      </div>
                      <div class="home-podium__col">
                        <div class="home-podium__bar" style="--h: 42%"></div>
                        <span>3</span>
                      </div>
                    </div>
                  )}
                </article>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
</Layout>
