---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase || !user) {
  throw new Error("Dashboard requires a signed-in membership");
}

const { data: membership, error: membershipError } = await supabase
  .from("team_members")
  .select("display_name, team_id")
  .eq("user_id", user.id)
  .single();

if (membershipError) {
  throw membershipError;
}

const displayName = readString(membership, "display_name");
const teamId = readString(membership, "team_id");

const { data: team, error: teamError } = await supabase.from("teams").select("name").eq("id", teamId).single();

if (teamError) {
  throw teamError;
}

const teamName = readString(team, "name");

function readString(row: unknown, key: string): string {
  if (typeof row !== "object" || row === null || !Object.hasOwn(row, key)) {
    throw new Error("Could not load team");
  }
  const value: unknown = Object.getOwnPropertyDescriptor(row, key)?.value;
  if (typeof value !== "string") {
    throw new Error("Could not load team");
  }
  return value;
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        <span class="font-semibold text-white">{displayName}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/80">Coach</p>
      <p class="mt-2 text-sm text-blue-100/50">{teamName}</p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
