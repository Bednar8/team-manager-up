---
import TeamShell from "@/layouts/TeamShell.astro";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase || !user) {
  throw new Error("Dashboard requires a signed-in membership");
}

const { data: membership, error: membershipError } = await supabase
  .from("team_members")
  .select("role, team_id")
  .eq("user_id", user.id)
  .single();

if (membershipError) {
  throw membershipError;
}

const role = readString(membership, "role");
const teamId = readString(membership, "team_id");

if (role !== "coach" && role !== "athlete") {
  throw new Error("Could not load team");
}

const { data: squad, error: squadError } = await supabase
  .from("team_members")
  .select("id, display_name, role")
  .eq("team_id", teamId);

if (squadError) {
  throw squadError;
}

const members = readMembers(squad).sort((a, b) => {
  if (a.role !== b.role) return a.role === "coach" ? -1 : 1;
  return a.displayName.localeCompare(b.displayName, "pl") || a.id.localeCompare(b.id);
});

const { data: codeRow, error: codeError } = await supabase
  .from("team_join_codes")
  .select("code")
  .eq("team_id", teamId)
  .maybeSingle();

if (codeError) {
  throw codeError;
}

const joinCode = role === "coach" && codeRow ? readString(codeRow, "code") : null;

function readString(row: unknown, key: string): string {
  if (typeof row !== "object" || row === null || !Object.hasOwn(row, key)) {
    throw new Error("Could not load team");
  }
  const value: unknown = Object.getOwnPropertyDescriptor(row, key)?.value;
  if (typeof value !== "string") {
    throw new Error("Could not load team");
  }
  return value;
}

function readMembers(rows: unknown): { id: string; displayName: string; role: "coach" | "athlete" }[] {
  if (!Array.isArray(rows)) {
    throw new Error("Could not load team");
  }
  return rows.map((row) => {
    const memberRole = readString(row, "role");
    if (memberRole !== "coach" && memberRole !== "athlete") {
      throw new Error("Could not load team");
    }
    return {
      id: readString(row, "id"),
      displayName: readString(row, "display_name"),
      role: memberRole,
    };
  });
}
---

<TeamShell title="Zespół">
  <main class="flex-1 px-4 py-8">
    <div class="mx-auto w-full max-w-md">
      <h1 class="text-3xl font-semibold">Zespół</h1>
      {joinCode && (
        <div class="mt-6">
          <p class="font-mono text-sm tracking-widest" data-team-code={joinCode}>
            {joinCode}
          </p>
          <a href="/team/code" class="mt-2 inline-block text-sm font-medium text-primary underline">
            Wymień kod
          </a>
        </div>
      )}
      <ul class="mt-6 space-y-2">
        {members.map((member) =>
          member.role === "coach" ? (
            <li class="rounded-md bg-accent px-4 py-3">
              <p class="font-semibold">{member.displayName}</p>
              <p class="text-sm text-accent-foreground">Trener</p>
            </li>
          ) : (
            <li class="rounded-md px-4 py-3">
              <p class="font-medium">{member.displayName}</p>
              <p class="text-sm text-muted-foreground">Zawodnik</p>
            </li>
          ),
        )}
      </ul>
    </div>
  </main>
</TeamShell>
