---
import TeamShell from "@/layouts/TeamShell.astro";
import MonthCalendar, { type ConfirmedSubmission, type SquadAthlete } from "@/components/calendar/MonthCalendar";
import { parseCivilDate } from "@/components/calendar/month";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase || !user) {
  throw new Error("Calendar requires a signed-in membership");
}

const { data: membership, error: membershipError } = await supabase
  .from("team_members")
  .select("role")
  .eq("user_id", user.id)
  .single();

if (membershipError) {
  throw membershipError;
}

const role = readString(membership, "role");

if (role !== "coach" && role !== "athlete") {
  throw new Error("Could not load team");
}

const { data: trainingRows, error: trainingsError } = await supabase
  .from("trainings")
  .select("training_on, description");

if (trainingsError) {
  throw trainingsError;
}

const trainings = trainingRows.map((row) => ({
  trainingOn: readString(row, "training_on"),
  description: readString(row, "description"),
}));

const athletes: SquadAthlete[] = role === "coach" ? await loadSquadAthletes(supabase) : [];
const confirmedSubmissions: ConfirmedSubmission[] = role === "coach" ? await loadConfirmedSubmissions(supabase) : [];

const dateParam = Astro.url.searchParams.get("date");
const initialDate = dateParam && parseCivilDate(dateParam) ? dateParam : undefined;
const error = Astro.url.searchParams.get("error") ?? undefined;
const messages = {
  created: "Trening dodany pomyślnie!",
  updated: "Trening zaktualizowany pomyślnie!",
  deleted: "Trening usunięty pomyślnie!",
};
let success: { date: string; message: string } | undefined;
if (role === "coach" && !error) {
  for (const [param, message] of Object.entries(messages)) {
    const date = Astro.url.searchParams.get(param);
    if (
      date &&
      parseCivilDate(date) &&
      (param === "deleted" || trainings.some((training) => training.trainingOn === date))
    ) {
      success = { date, message };
      break;
    }
  }
}
const warsawToday = new Intl.DateTimeFormat("en-CA", {
  timeZone: "Europe/Warsaw",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(new Date());

if (!parseCivilDate(warsawToday)) {
  throw new Error("Could not load team");
}

const submission = role === "athlete" && initialDate ? await loadSubmission(supabase, user.id, initialDate) : null;

function readString(row: unknown, key: string): string {
  if (typeof row !== "object" || row === null || !Object.hasOwn(row, key)) {
    throw new Error("Could not load team");
  }
  const value: unknown = Object.getOwnPropertyDescriptor(row, key)?.value;
  if (typeof value !== "string") {
    throw new Error("Could not load team");
  }
  return value;
}

async function loadSubmission(client: NonNullable<typeof supabase>, userId: string, trainingOn: string) {
  const { data: trainingRow, error: trainingError } = await client
    .from("trainings")
    .select("id")
    .eq("training_on", trainingOn)
    .maybeSingle();

  if (trainingError) {
    throw trainingError;
  }
  if (!trainingRow) {
    return null;
  }

  const { data: submissionRow, error: submissionError } = await client
    .from("training_submissions")
    .select(
      "distance_km, duration_seconds, max_speed_kmh, model_distance_km, model_duration_seconds, model_max_speed_kmh, athlete_edited, confirmed_at",
    )
    .eq("training_id", readString(trainingRow, "id"))
    .eq("user_id", userId)
    .maybeSingle();

  if (submissionError) {
    throw submissionError;
  }
  if (!submissionRow) {
    return null;
  }

  return {
    distanceKm: readNullableNumber(submissionRow, "distance_km"),
    durationSeconds: readNullableInteger(submissionRow, "duration_seconds"),
    maxSpeedKmh: readNullableNumber(submissionRow, "max_speed_kmh"),
    modelDistanceKm: readNullableNumber(submissionRow, "model_distance_km"),
    modelDurationSeconds: readNullableInteger(submissionRow, "model_duration_seconds"),
    modelMaxSpeedKmh: readNullableNumber(submissionRow, "model_max_speed_kmh"),
    athleteEdited: readBoolean(submissionRow, "athlete_edited"),
    confirmedAt: readNullableString(submissionRow, "confirmed_at"),
  };
}

function readOwn(row: unknown, key: string): unknown {
  if (typeof row !== "object" || row === null || !Object.hasOwn(row, key)) {
    throw new Error("Could not load team");
  }
  return Object.getOwnPropertyDescriptor(row, key)?.value;
}

function readNullableNumber(row: unknown, key: string): number | null {
  const value = readOwn(row, key);
  if (value === null) {
    return null;
  }
  if (typeof value === "number" && Number.isFinite(value)) {
    return value;
  }
  if (typeof value === "string" && value.trim() !== "") {
    const parsed = Number(value);
    if (Number.isFinite(parsed)) {
      return parsed;
    }
  }
  throw new Error("Could not load team");
}

function readNullableInteger(row: unknown, key: string): number | null {
  const value = readNullableNumber(row, key);
  if (value === null) {
    return null;
  }
  if (!Number.isInteger(value)) {
    throw new Error("Could not load team");
  }
  return value;
}

function readBoolean(row: unknown, key: string): boolean {
  const value = readOwn(row, key);
  if (typeof value !== "boolean") {
    throw new Error("Could not load team");
  }
  return value;
}

function readNullableString(row: unknown, key: string): string | null {
  const value = readOwn(row, key);
  if (value === null) {
    return null;
  }
  if (typeof value !== "string") {
    throw new Error("Could not load team");
  }
  return value;
}

async function loadSquadAthletes(client: NonNullable<typeof supabase>) {
  const { data, error } = await client
    .from("team_members")
    .select("user_id, display_name, created_at, id")
    .eq("role", "athlete");

  if (error) {
    throw error;
  }
  if (!Array.isArray(data)) {
    throw new Error("Could not load team");
  }

  return data.map((row) => ({
    userId: readString(row, "user_id"),
    displayName: readString(row, "display_name"),
    createdAt: readString(row, "created_at"),
    id: readString(row, "id"),
  }));
}

async function loadConfirmedSubmissions(client: NonNullable<typeof supabase>) {
  const { data, error } = await client
    .from("training_submissions")
    .select("user_id, athlete_edited, submitter_display_name, trainings(training_on)")
    .not("confirmed_at", "is", null);

  if (error) {
    throw error;
  }
  if (!Array.isArray(data)) {
    throw new Error("Could not load team");
  }

  return data.map((row) => ({
    trainingOn: readEmbeddedTrainingOn(row),
    userId: readString(row, "user_id"),
    displayName: readSubmitterName(row),
    athleteEdited: readBoolean(row, "athlete_edited"),
  }));
}

function readEmbeddedTrainingOn(row: unknown): string {
  const embedded = readOwn(row, "trainings");
  if (typeof embedded !== "object" || embedded === null || Array.isArray(embedded)) {
    throw new Error("Could not load team");
  }
  return readString(embedded, "training_on");
}

function readSubmitterName(row: unknown): string {
  const name = readNullableString(row, "submitter_display_name");
  if (name === null || name === "") {
    return "Zawodnik";
  }
  return name;
}
---

<TeamShell title="Kalendarz">
  <main class="flex min-h-[calc(100dvh-9rem)] flex-1 flex-col px-3 py-4 lg:min-h-[calc(100dvh-6rem)] lg:px-6">
    <MonthCalendar
      initialDate={success ? undefined : initialDate}
      success={success}
      warsawToday={warsawToday}
      role={role}
      trainings={trainings}
      athletes={athletes}
      confirmedSubmissions={confirmedSubmissions}
      submission={submission}
      submissionDate={role === "athlete" ? (initialDate ?? null) : null}
      error={error}
      client:load
    />
  </main>
</TeamShell>
